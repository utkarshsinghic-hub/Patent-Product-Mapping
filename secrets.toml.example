# Local: copy to .streamlit/secrets.toml.   Cloud: use the platform's secret manager / env vars instead.
GEMINI_API_KEY = "your-gemini-key"
# GEMINI_MODEL = "gemini-3.1-flash-lite"
PERSIST_REVIEWS = "true"       # "false": review results are kept in memory only, nothing about claims is written to disk

[auth]
admins = ["admin"]
[auth.users]
# generate each value with:  python make_password_hash.py
admin   = "pbkdf2_sha256$310000$...$..."
client1 = "pbkdf2_sha256$310000$...$..."

[limits]                       # optional; these are the defaults for client accounts
max_upload_mb = 25
max_patents = 3000
max_limitations = 60000
daily_review_calls = 1000
calls_per_run = 400
